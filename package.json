{
  "name": "pixlad",
  "version": "0.1.0",
  "private": true,
  "description": "Drop JPEG photos, mosaic faces and areas, export JPEGs. Nothing else.",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/filipkauffeldt/mosaic-retouch",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/fetch-model.ts",
    "fetch-model": "node scripts/fetch-model.ts",
    "fetch-fixtures": "node scripts/fetch-fixtures.ts",
    "render-icon": "node scripts/render-icon.ts",
    "notices": "node scripts/third-party-notices.ts",
    "notices:check": "node scripts/third-party-notices.ts --check",
    "dev": "node scripts/ensure-electron.mjs && electron-vite dev",
    "build": "electron-vite build",
    "start": "node scripts/ensure-electron.mjs && electron-vite build && electron-vite preview",
    "start:no-sandbox": "node scripts/ensure-electron.mjs && electron-vite build && electron-vite preview -- --no-sandbox",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --exclude \"test/e2e/**\" --exclude \"test/package/**\"",
    "test:e2e": "node scripts/ensure-electron.mjs && electron-vite build && vitest run --config vitest.e2e.config.ts",
    "package": "electron-vite build && electron-builder",
    "test:package": "vitest run --config vitest.package.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "onnxruntime-node": "1.31.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "exiftool-vendored": "39.0.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
